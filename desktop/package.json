{
  "name": "llm-cost-tracker",
  "version": "2.0.0",
  "description": "Real-time cost monitoring and optimization platform for AI API services",
  "main": "main.js",
  "author": {
    "name": "LLM Cost Tracker",
    "email": "support@llmcosttracker.com"
  },
  "license": "MIT",
  "homepage": "https://llmcosttracker.com",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder --win --mac --linux --publish never",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.llmcosttracker.desktop",
    "productName": "LLM Cost Tracker",
    "copyright": "Copyright © 2026 LLM Cost Tracker",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      {
        "from": "..",
        "to": "app",
        "filter": [
          "**/*",
          "!node_modules",
          "!desktop",
          "!desktop/dist",
          "!desktop/build",
          "!*.db",
          "!__pycache__",
          "!*.pyc"
        ]
      }
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.png",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LLM Cost Tracker",
      "installerIcon": "icon.png",
      "uninstallerIcon": "icon.png",
      "installerHeaderIcon": "icon.png",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "dmg": {
      "backgroundColor": "#08080d",
      "window": {
        "width": 560,
        "height": 400
      }
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "icon.png",
      "category": "Development",
      "artifactName": "${productName}-${version}-linux.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
