DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_cost_tracker
SECRET_KEY=change-this-to-a-secret-key-in-production
REDIS_URL=redis://localhost:6379/0

# --- Billing / Subscription (Stripe) ---
# Leave STRIPE_SECRET_KEY empty to run in free-only (test) mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:8000
# Set to false once you add your real Stripe keys.
DISABLE_BILLING=true
