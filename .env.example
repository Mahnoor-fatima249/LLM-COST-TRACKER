# Database (SQLite by default, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./llm_cost_tracker.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/llm_cost_tracker

# JWT Secret (change in production!)
SECRET_KEY=change-this-to-a-secret-key-in-production

# Billing / Stripe (leave empty for free mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:8000
DISABLE_BILLING=true
